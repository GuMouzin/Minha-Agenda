{
  "name": "minha-agenda",
  "version": "2.2.0",
  "description": "Minha Agenda",
  "author": "Gustavo Mouzin",
  "main": "main.js",
  "scripts": {
    "start": "npm run build:sync && electron .",
    "build": "npm run build:sync && electron-builder",
    "build:sync": "node scripts/build-web.js",
    "build:web": "node scripts/build-web.js --www",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "firebase": "^13.4.0"
  },
  "build": {
    "appId": "com.minhaagenda.app",
    "productName": "Minha Agenda",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh",
      "artifactName": "Minha-Agenda-Setup-${version}.${ext}"
    },
    "files": [
      "main.js",
      "index.html",
      "reminder.html",
      "style.css",
      "script.js",
      "assets/**/*",
      "mobile.js",
      "firebase-config.js",
      "sync.bundle.js"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "allowScripts": {
    "electron@30.5.1": true
  },
  "license": "MIT"
}
