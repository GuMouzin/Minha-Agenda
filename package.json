{
  "name": "minha-agenda",
  "version": "2.1.0",
  "description": "Minha Agenda",
  "author": "Gustavo Mouzin",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.minhaagenda.app",
    "productName": "Minha Agenda",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh"
    },
    "files": [
      "main.js",
      "index.html",
      "reminder.html",
      "style.css",
      "script.js",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}